{
  "name": "Wii OS Web",
  "font": "system-ui, sans-serif",
  "colors": {
    "page": "#f5f7fb",
    "surface": "#ffffff",
    "surface-soft": "#f8f9fc",
    "ink": "#21283a",
    "muted": "#687186",
    "accent": "#5968d9",
    "accent-ink": "#4957c5",
    "accent-deep": "#3948b5",
    "accent-soft": "#edf0ff",
    "success": "#2a9a78",
    "line": "#e8ebf2",
    "danger": "#a03c38"
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48],
  "radii": { "small": 12, "medium": 18, "large": 26 },
  "contrastPairs": [
    { "foreground": "#21283a", "background": "#f5f7fb", "role": "body text / page" },
    { "foreground": "#687186", "background": "#ffffff", "role": "secondary text / surface" },
    { "foreground": "#4957c5", "background": "#f5f7fb", "role": "link / page" },
    { "foreground": "#ffffff", "background": "#5968d9", "role": "button label / accent" },
    { "foreground": "#a03c38", "background": "#ffffff", "role": "error text / surface" }
  ]
}
